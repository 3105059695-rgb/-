# ==========================================
# 桐薇宇宙 - 环境变量配置
# ==========================================

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Pinecone (向量记忆库)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=tongwei-memories

# PostgreSQL (用户数据与事件存储)
# 本地开发可用 Vercel Postgres 或自建 PostgreSQL
POSTGRES_URL=postgres://user:password@localhost:5432/tongwei_universe
POSTGRES_PRISMA_URL=postgres://user:password@localhost:5432/tongwei_universe
POSTGRES_URL_NON_POOLING=postgres://user:password@localhost:5432/tongwei_universe
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=tongwei_universe

# NextAuth / Session
NEXTAUTH_SECRET=generate-a-random-secret-string-here
NEXTAUTH_URL=http://localhost:3000

# 网站配置
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=桐薇宇宙

# 定时任务密钥 (用于 /api/daily-life 定时触发)
CRON_SECRET=generate-another-random-secret-here
